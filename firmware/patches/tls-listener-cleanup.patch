+static void ssl_close_failed_handshake(mp_obj_ssl_socket_t *sslsock) {
+    #if MICROPY_IOTMD_TRANSPORT_DIAGNOSTICS
+    iotmd_transport_tls_close(sslsock);
+    #endif
+    // Detach before closing, so Stream.close()/finalisation remain idempotent.
+    // Dropping this reference alone leaves the TCP fd alive until GC and can
+    // exhaust internal TLS/lwIP resources even with plentiful PSRAM available.
+    mp_obj_t sock = sslsock->sock;
+    sslsock->sock = MP_OBJ_NULL;
+    mbedtls_ssl_free(&sslsock->ssl);
+    if (sock != MP_OBJ_NULL) {
+        int ignored_errno = 0;
+        mp_get_stream(sock)->ioctl(sock, MP_STREAM_CLOSE, 0, &ignored_errno);
+    }
+}
