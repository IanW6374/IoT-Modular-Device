diff --git a/extmod/modtls_mbedtls.c b/extmod/modtls_mbedtls.c
index 13cd6e3..fcd3316 100644
--- a/extmod/modtls_mbedtls.c
+++ b/extmod/modtls_mbedtls.c
@@ -40,4 +40,5 @@
 #include "py/mphal.h"
 #include "py/gc.h"
+#include "iotmd_transport_diagnostics.h"
 #include "extmod/vfs.h"
 
@@ -128,4 +129,14 @@ static const mp_obj_type_t ssl_context_type;
 static const mp_obj_type_t ssl_socket_type;
 
+static void tls_diagnostic_result(mp_obj_ssl_socket_t *socket, int result) {
+    bool failed = result < 0 && result != MBEDTLS_ERR_SSL_WANT_READ &&
+        result != MBEDTLS_ERR_SSL_WANT_WRITE && result != MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY &&
+        result != MBEDTLS_ERR_SSL_CONN_EOF;
+    #if defined(MBEDTLS_SSL_PROTO_TLS1_3)
+    failed = failed && result != MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET;
+    #endif
+    iotmd_transport_tls_leave(socket, result, mbedtls_ssl_is_handshake_over(&socket->ssl), failed);
+}
+
 static const MP_DEFINE_STR_OBJ(mbedtls_version_obj, MBEDTLS_VERSION_STRING_FULL);
 
@@ -768,5 +779,9 @@ static mp_obj_t ssl_socket_make_new(mp_obj_ssl_context_t *ssl_context, mp_obj_t
     mbedtls_ssl_init(&o->ssl);
 
+    iotmd_transport_tls_open(o);
+    iotmd_transport_tls_enter(o, IOTMD_TLS_SETUP);
+
     ret = mbedtls_ssl_setup(&o->ssl, &ssl_context->conf);
+    tls_diagnostic_result(o, ret);
     #if !MICROPY_MBEDTLS_CONFIG_BARE_METAL
     if (ret != 0) {
@@ -776,5 +791,7 @@ static mp_obj_t ssl_socket_make_new(mp_obj_ssl_context_t *ssl_context, mp_obj_t
         // frees some platform-level heap.
         gc_collect();
+        iotmd_transport_tls_enter(o, IOTMD_TLS_SETUP);
         ret = mbedtls_ssl_setup(&o->ssl, &ssl_context->conf);
+        tls_diagnostic_result(o, ret);
     }
     #endif
@@ -791,4 +808,5 @@ static mp_obj_t ssl_socket_make_new(mp_obj_ssl_context_t *ssl_context, mp_obj_t
     } else if (ssl_context->authmode == MBEDTLS_SSL_VERIFY_REQUIRED && server_side == false) {
 
+        iotmd_transport_tls_close(o);
         o->sock = MP_OBJ_NULL;
         mbedtls_ssl_free(&o->ssl);
@@ -817,5 +835,11 @@ static mp_obj_t ssl_socket_make_new(mp_obj_ssl_context_t *ssl_context, mp_obj_t
 
     if (do_handshake_on_connect) {
-        while ((ret = mbedtls_ssl_handshake(&o->ssl)) != 0) {
+        while (true) {
+            iotmd_transport_tls_enter(o, IOTMD_TLS_HANDSHAKE);
+            ret = mbedtls_ssl_handshake(&o->ssl);
+            tls_diagnostic_result(o, ret);
+            if (ret == 0) {
+                break;
+            }
             if (ret != MBEDTLS_ERR_SSL_WANT_READ && ret != MBEDTLS_ERR_SSL_WANT_WRITE) {
                 goto cleanup;
@@ -828,4 +852,5 @@ static mp_obj_t ssl_socket_make_new(mp_obj_ssl_context_t *ssl_context, mp_obj_t
 
 cleanup:
+    iotmd_transport_tls_close(o);
     if (ret == MBEDTLS_ERR_X509_CERT_VERIFY_FAILED) {
         flags = mbedtls_ssl_get_verify_result(&o->ssl);
@@ -886,5 +911,7 @@ static mp_uint_t socket_read(mp_obj_t o_in, void *buf, mp_uint_t size, int *errc
     store_active_context(o->ssl_context);
 
+    iotmd_transport_tls_enter(o, IOTMD_TLS_READ);
     int ret = mbedtls_ssl_read(&o->ssl, buf, size);
+    tls_diagnostic_result(o, ret);
     if (ret == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY) {
         // end of stream
@@ -930,5 +957,7 @@ static mp_uint_t socket_write(mp_obj_t o_in, const void *buf, mp_uint_t size, in
     store_active_context(o->ssl_context);
 
+    iotmd_transport_tls_enter(o, IOTMD_TLS_WRITE);
     int ret = mbedtls_ssl_write(&o->ssl, buf, size);
+    tls_diagnostic_result(o, ret);
     if (ret >= 0) {
         return ret;
@@ -967,4 +996,5 @@ static mp_uint_t socket_ioctl(mp_obj_t o_in, mp_uint_t request, uintptr_t arg, i
 
     if (request == MP_STREAM_CLOSE) {
+        iotmd_transport_tls_close(self);
         // Clear the SSL context.
         store_active_context(NULL);
